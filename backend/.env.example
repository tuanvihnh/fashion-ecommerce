# ============================
# Fashion E-commerce Backend
# ============================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fashion_ecommerce
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/fashion_ecommerce

# --- JWT Authentication ---
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- App ---
APP_NAME=Fashion E-commerce API
APP_VERSION=1.0.0
DEBUG=true

# VNPAY Config (MOCK cho môi trường Dev)
VNPAY_TMN_CODE=MOCK_TMN_CODE
VNPAY_HASH_SECRET=MOCK_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/api/v1/payments/vnpay_return
